# Copy to .env on the deployment host, replace every placeholder, and restrict file permissions.
LIFEOS_DOMAIN=lifeos.example.com
PROCESSING_MODE=worker
IMPORTS_ENABLED=true

POSTGRES_DB=lifeos
POSTGRES_USER=lifeos
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
DATABASE_URL=postgresql+psycopg://lifeos:replace-with-a-long-random-database-password@db:5432/lifeos

ACCESS_TOKEN_SECRET=replace-with-a-unique-random-secret-of-at-least-32-characters
REGISTRATION_MODE=invitation
SIGNUP_INVITE_CODE=replace-with-a-separate-random-invitation-code
METRICS_TOKEN=replace-with-a-separate-random-metrics-token-of-at-least-32-characters

S3_BUCKET=lifeos-private-production
S3_REGION=us-east-1
S3_ENDPOINT_URL=
# Keep the deletion journal outside the failure domain of the primary bucket.
S3_DELETION_JOURNAL_BUCKET=lifeos-deletion-journal
S3_DELETION_JOURNAL_REGION=
S3_DELETION_JOURNAL_ENDPOINT_URL=

MODEL_PROVIDER=none
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
MODEL_DISCLOSURE_VERSION=openai-chat-completions-v1
MODEL_DISCLOSURE_DATA="Selected timeline item dates, titles, source-item IDs, and text for the requested review period. A sanitized photo is sent only when the user requests an image description."
MODEL_DISCLOSURE_RETENTION="Describe the configured provider's current retention and privacy terms before enabling external inference."
MODEL_PRIVACY_URL=
# Enter current per-million-token prices for OPENAI_MODEL before enabling the provider.
MODEL_INPUT_COST_PER_MILLION_USD=0
MODEL_OUTPUT_COST_PER_MILLION_USD=0
MODEL_MAX_COST_PER_CALL_USD=0.10

# The backup destination must be a different private, encrypted bucket with a 35-day lifecycle.
BACKUP_S3_URI=s3://lifeos-encrypted-backups/production
