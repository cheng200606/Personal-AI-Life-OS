{
  "name": "Personal AI Life OS",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest"
    }
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": 16,
    "storage": "32gb"
  },
  "forwardPorts": [5173],
  "portsAttributes": {
    "5173": {
      "label": "Web client",
      "onAutoForward": "openBrowserOnce",
      "visibility": "private"
    }
  },
  "otherPortsAttributes": {
    "onAutoForward": "ignore"
  },
  "postCreateCommand": "docker compose -f docker-compose.yml -f docker-compose.codespaces.yml up --build --detach --wait",
  "postStartCommand": "docker compose -f docker-compose.yml -f docker-compose.codespaces.yml up --detach --wait",
  "remoteUser": "vscode"
}
