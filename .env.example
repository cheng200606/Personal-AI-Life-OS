APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
DATABASE_URL=sqlite+pysqlite:///./data/lifeos.db
DATA_DIR=./data
AUTO_CREATE_SCHEMA=true
PROCESSING_MODE=inline
ACCESS_TOKEN_SECRET=local-development-only-change-this-value
REGISTRATION_MODE=open
OBJECT_STORE_BACKEND=local
# External AI stays off until MODEL_PROVIDER=openai, OPENAI_API_KEY is set, and both
# per-million-token prices below are greater than zero. Any OpenAI-compatible gateway works:
# point OPENAI_BASE_URL at its API root (for example https://your-gateway.example/v1).
MODEL_PROVIDER=none
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
METRICS_TOKEN=local-development-metrics-token
MODEL_INPUT_COST_PER_MILLION_USD=0
MODEL_OUTPUT_COST_PER_MILLION_USD=0
MODEL_MAX_COST_PER_CALL_USD=0.10
